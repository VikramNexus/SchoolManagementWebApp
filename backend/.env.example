# ============================================================
# SCHOOL STUDENT & FEE MANAGEMENT SYSTEM — Environment Template
# Copy this file to `.env` and fill in your real values.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# NEVER commit the real `.env` file to version control.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Frontend CORS origin (where the React/Vite app runs) ---
CLIENT_URL=http://localhost:3000

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=school_management_db
DB_CONNECTION_LIMIT=10

# --- JWT Authentication ---
# Use a long random string in production, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Messaging (SMS / WhatsApp) — configured later (Day 16+) ---
# mock = log messages to DB without external API costs
# Valid modes: mock, twilio, meta (for WhatsApp)
SMS_MODE=mock
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

WHATSAPP_MODE=mock
WHATSAPP_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_ID=

# --- PDF Receipts ---
# Directory where generated PDF receipts are stored
RECEIPTS_DIR=./data/receipts

# --- Database Backup ---
BACKUP_DIR=./data/backups
# Paths to mysqldump and mysql binaries (required for backup/restore on Windows)
# Windows example: MYSQLDUMP_PATH="C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqldump.exe"
# Linux/Mac: usually in PATH, so no need to set
MYSQLDUMP_PATH=
MYSQL_PATH=
